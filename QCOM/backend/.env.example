# ==============================================================================
# QCOM BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT commit real credentials or production secrets to source control.
#
# NOTICE: QCOM has not selected a payment gateway. No provider integration, SDK,
# gateway credentials, sandbox transactions, or live payment transactions are
# implemented or authorized.

# Application Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Authoritative Database (Supabase PostgreSQL / Direct PostgreSQL 16)
# For Supabase hosted environment:
# - DATABASE_URL: Transaction Pooler via Supavisor (Port 6543) or Session Mode (Port 5432)
# - DATABASE_POOL_URL: Direct / Pooler URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qcom_db
DATABASE_POOL_URL=postgresql://postgres.projectref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_MAX_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Ephemeral Acceleration (Redis 7.0.15 — Strictly Cache / PubSub / Rate Limit / Mutex)
# NOTE: Integration tests & CI strictly require exact Redis 7.0.15 (redis:7.0.15-alpine).
#       Redis is NEVER the authoritative source of truth for orders, payments, idempotency, inventory, or balances.
REDIS_URL=redis://127.0.0.1:6379
EXPECTED_REDIS_VERSION=7.0.15

# Pluggable Provider Modes
# PAYMENT_MODE options:
#   - 'none'       : No payment gateway selected (recommended when bootstrapping staging/prod before gateway selection; online payment APIs fail closed with 503)
#   - 'mock'       : Test-only offline mock simulator (strictly prohibited when NODE_ENV=production)
#   - 'production' : Future live gateway mode (requires explicit PAYMENT_PROVIDER and high-entropy credentials)
PAYMENT_MODE=mock
# PAYMENT_PROVIDER=
# TELEPHONY_MODE options: 'mock' (test-only) | 'exotel' | 'twilio'
TELEPHONY_MODE=mock

# CORS Allowlist (Comma-separated client origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# Comma-separated trusted reverse-proxy IPs/CIDRs. Leave empty unless deployed behind a proxy.
TRUST_PROXY_CIDRS=

# Security & Core Services (Replace all dev secrets with high-entropy >=32 char secrets before production!)
JWT_SECRET=qcom_dev_secret_replace_in_production_key_2026
ADMIN_SESSION_TTL_HOURS=24
OSRM_BASE_URL=https://router.project-osrm.org

# Future Gateway Credentials (Unconfigured until Founder selects a payment gateway)
# PAYMENT_GATEWAY_KEY_ID=
# PAYMENT_GATEWAY_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# QCOM Platform GST Identity & NIC IRP E-Invoicing (Leave QCOM_GSTIN unset if unconfigured; never fabricate)
# QCOM_GSTIN=
# QCOM_LEGAL_NAME=QCOM Logistics & Platform Services
# QCOM_STATE_CODE=29
EINVOICING_ENABLED=false
