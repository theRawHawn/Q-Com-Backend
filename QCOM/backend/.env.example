# ==============================================================================
# QCOM BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT commit real credentials or production secrets to source control.

# Application Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Authoritative Database (Supabase PostgreSQL / Direct PostgreSQL)
# For Supabase hosted environment:
# - DATABASE_URL: Transaction Pooler via Supavisor (Port 6543) or Session Mode (Port 5432)
# - DATABASE_POOL_URL: Direct / Pooler URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qcom_db
DATABASE_POOL_URL=postgresql://postgres.projectref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_MAX_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Ephemeral Acceleration (Redis - Strictly Cache / PubSub / Rate Limit / Mutex)
# NOTE: Redis is NEVER the authoritative source of truth for orders, inventory, or balances.
REDIS_URL=redis://localhost:6379

# Pluggable Provider Modes
# PAYMENT_MODE options: 'mock' (default) | 'razorpay_test' | 'production'
PAYMENT_MODE=mock
# TELEPHONY_MODE options: 'mock' (default) | 'exotel' | 'twilio'
TELEPHONY_MODE=mock

# CORS Allowlist (Comma-separated client origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Future Integrations (Placeholders for Sprint 2+ — Keep Empty in Sprint 1)
JWT_SECRET=qcom_dev_secret_replace_in_production_key_2026
ADMIN_SESSION_TTL_HOURS=24
OSRM_BASE_URL=https://router.project-osrm.org
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
